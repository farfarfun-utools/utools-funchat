{
  "pluginName": "言来语往",
  "version": "1.0.1",
  "description": "言来语往 FunChat：多角色 AI 对话，支持角色市场、话题回溯与一键导出；会话和配置保存在本地",
  "author": "farfarfun",
  "main": "dist/index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true,
    "height": 660
  },
  "features": [
    {
      "code": "funchat",
      "explain": "打开言来语往 FunChat",
      "description": "打开言来语往 FunChat",
      "icon": "logo.png",
      "cmds": [
        "言来语往",
        "funchat",
        "Funchat",
        "聊天助手",
        "AI"
      ]
    },
    {
      "code": "funchat-over",
      "explain": "把选中的文字丢给 AI 好友",
      "description": "把选中的文字丢给 AI 好友",
      "icon": "logo.png",
      "cmds": [
        {
          "type": "over",
          "label": "问 AI 好友",
          "maxLength": 100000
        }
      ]
    }
  ],
  "platform": [
    "darwin",
    "win32",
    "linux"
  ]
}
