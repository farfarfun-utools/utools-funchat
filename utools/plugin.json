{
  "pluginName": "好友聊天 FunChat",
  "version": "0.1.1",
  "description": "把一屋子 AI 好友装进 uTools：多角色切换、话题回溯、一键导出，数据全在本地",
  "author": "farfarfun",
  "main": "dist/index.html",
  "preload": "preload.js",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true,
    "height": 660
  },
  "features": [
    {
      "code": "funchat",
      "explain": "打开 funchat",
      "description": "打开 funchat",
      "icon": "logo.png",
      "cmds": [
        "funchat",
        "Funchat",
        "聊天助手"
      ]
    },
    {
      "code": "funchat-over",
      "explain": "把选中的文字丢给 AI 好友",
      "description": "把选中的文字丢给 AI 好友",
      "icon": "logo.png",
      "cmds": [
        {
          "type": "over",
          "label": "问 AI 好友",
          "maxLength": 4000
        }
      ]
    }
  ],
  "platform": [
    "darwin",
    "win32",
    "linux"
  ]
}
